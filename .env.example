# Copy to .env.local for local runs. Set the same variables on the host (Railway) for production.

# Canonical URL of this site (meta tags, sitemap). Defaults to https://telemetrix.io.
NEXT_PUBLIC_SITE_URL=

# Public Windows installer URL. Empty → the download page offers early access instead of a link.
# NEXT_PUBLIC_ vars are baked in at build time: rebuild after changing it.
NEXT_PUBLIC_WINDOWS_DOWNLOAD_URL=

# Google Analytics 4 measurement id (G-XXXXXXXXXX). Empty → no analytics.
NEXT_PUBLIC_GA_ID=

# Contact form → email via Resend (https://resend.com). Empty → the form offers "send it by email instead".
RESEND_API_KEY=
CONTACT_TO_EMAIL=
# A sender on a domain verified in Resend, e.g. "Telemetrix website <web@telemetrix.io>".
CONTACT_FROM_EMAIL=
